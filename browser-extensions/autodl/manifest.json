{
  "manifest_version": 3,
  "name": "Draw studio · AutoDL.Art",
  "version": "1.2.0",
  "description": "使用当前浏览器中的 AutoDL.Art 会话，为本机 Draw studio 管理已绑定实例。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://www.autodl.art/*"],
  "externally_connectable": { "matches": ["http://127.0.0.1/*", "http://localhost/*"] },
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Draw studio · AutoDL.Art" }
}
