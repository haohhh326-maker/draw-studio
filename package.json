{
  "name": "ai-infinite-canvas",
  "private": true,
  "license": "MIT",
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "tauri": "tauri",
    "desktop": "electron scripts/desktop-host.cjs",
    "desktop:live": "electron scripts/desktop-host.cjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --config electron-builder.cjs --win --x64",
    "desktop:release:manifest": "node scripts/prepare-software-release.mjs",
    "format": "prettier --write src tests *.ts *.json *.md"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "@tauri-apps/plugin-websocket": "^2.0.0",
    "@xyflow/react": "^12.0.0",
    "fflate": "^0.8.2",
    "form-data": "4.0.6",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "node-fetch": "3.3.2",
    "playwright": "1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "ws": "8.21.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.8",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
